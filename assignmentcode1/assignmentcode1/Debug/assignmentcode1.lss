                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; TRAFFIC LIGHT CONTROLLER
                                 ; ATmega328P / Arduino UNO
                                 ;
                                 ; Converted from Arduino C++ program
                                 ; Clock: 16 MHz
                                 ; ============================================================
                                 
                                 .include "m328pdef.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; ============================================================
                                 ; REGISTER DEFINITIONS
                                 ; ============================================================
                                 
                                 .def temp       = r16
                                 .def temp2      = r17
                                 .def temp3      = r18
                                 .def counter    = r19
                                 .def digit      = r20
                                 
                                 ; ============================================================
                                 ; SRAM VARIABLES
                                 ; ============================================================
                                 
                                 .dseg
                                 pedRequest:
000100                               .byte 1
                                 ms_low:
000101                               .byte 1
                                 ms_mid:
000102                               .byte 1
                                 ms_high:
000103                               .byte 1
                                 ms_top:
000104                               .byte 1
                                 
                                 .cseg
                                 
                                 ; ============================================================
                                 ; INTERRUPT VECTOR TABLE
                                 ; ============================================================
                                 .org 0x0000
000000 c016                          rjmp RESET
                                 .org INT0addr
000002 c127                          rjmp INT0_ISR
                                 .org OC1Aaddr
000016 c11d                          rjmp TIMER1_COMPA_ISR
                                 
                                 ; ============================================================
                                 ; RESET & CONFIGURATION
                                 ; ============================================================
                                 RESET:
                                     ; Initialize Stack Pointer
000017 e008                          ldi temp, high(RAMEND)
000018 bf0e                          out SPH, temp
000019 ef0f                          ldi temp, low(RAMEND)
00001a bf0d                          out SPL, temp
                                 
                                     ; PORT B (Traffic Lights)
00001b e30f                          ldi temp, 0b00111111
00001c b904                          out DDRB, temp
00001d e000                          ldi temp, 0
00001e b905                          out PORTB, temp
                                 
                                     ; PORT D (7-Seg & Button)
00001f ef08                          ldi temp, 0b11111000
000020 b90a                          out DDRD, temp
000021 e004                          ldi temp, (1<<PD2)   ; Enable pull-up on PD2
000022 b90b                          out PORTD, temp
                                 
                                     ; PORT C (7-Seg & Night Switch)
000023 e003                          ldi temp, 0b00000011
000024 b907                          out DDRC, temp
000025 e004                          ldi temp, (1<<PC2)   ; Enable pull-up on PC2
000026 b908                          out PORTC, temp
                                 
                                     ; Initialize Variables
000027 e000                          ldi temp, 0
000028 9300 0100                     sts pedRequest, temp
00002a 9300 0101                     sts ms_low, temp
00002c 9300 0102                     sts ms_mid, temp
00002e 9300 0103                     sts ms_high, temp
000030 9300 0104                     sts ms_top, temp
                                 
                                     ; Timer1 (1ms tick)
000032 e000                          ldi temp, high(249)
000033 9300 0089                     sts OCR1AH, temp
000035 ef09                          ldi temp, low(249)
000036 9300 0088                     sts OCR1AL, temp
000038 e008                          ldi temp, (1<<WGM12)
000039 9300 0081                     sts TCCR1B, temp
00003b e00b                          ldi temp, (1<<WGM12)|(1<<CS11)|(1<<CS10)
00003c 9300 0081                     sts TCCR1B, temp
00003e e002                          ldi temp, (1<<OCIE1A)
00003f 9300 006f                     sts TIMSK1, temp
                                 
                                     ; INT0 Configuration
000041 e002                          ldi temp, (1<<ISC01)
000042 9300 0069                     sts EICRA, temp
000044 e001                          ldi temp, (1<<INT0)
000045 9300 001d                     sts EIMSK, temp
                                 
000047 9478                          sei
000048 d0d9                          rcall CLEAR_DISPLAY
                                 
                                 ; ============================================================
                                 ; MAIN LOOP
                                 ; ============================================================
                                 MAIN_LOOP:
000049 d071                          rcall IS_NIGHT
00004a 2300                          tst temp
00004b f569                          brne NIGHT_MODE
                                 
                                 PHASE1:
00004c e00c                          ldi temp, (1<<PB3)|(1<<PB2)
00004d b905                          out PORTB, temp
00004e eb88                          ldi r24, low(3000)
00004f e09b                          ldi r25, high(3000)
000050 d058                          rcall SMART_DELAY
000051 2300                          tst temp
000052 f7b1                          brne MAIN_LOOP
                                 
                                 PHASE2:
000053 e204                          ldi temp, (1<<PB5)|(1<<PB2)
000054 b905                          out PORTB, temp
000055 ee88                          ldi r24, low(1000)
000056 e093                          ldi r25, high(1000)
000057 d051                          rcall SMART_DELAY
000058 2300                          tst temp
000059 f779                          brne MAIN_LOOP
00005a d06e                          rcall CHECK_PEDESTRIAN
                                 
                                 PHASE3:
00005b e202                          ldi temp, (1<<PB5)|(1<<PB1)
00005c b905                          out PORTB, temp
00005d ee88                          ldi r24, low(1000)
00005e e093                          ldi r25, high(1000)
00005f d049                          rcall SMART_DELAY
000060 2300                          tst temp
000061 f739                          brne MAIN_LOOP
                                 
                                 PHASE4:
000062 e201                          ldi temp, (1<<PB5)|(1<<PB0)
000063 b905                          out PORTB, temp
000064 eb88                          ldi r24, low(3000)
000065 e09b                          ldi r25, high(3000)
000066 d042                          rcall SMART_DELAY
000067 2300                          tst temp
000068 f701                          brne MAIN_LOOP
                                 
                                 PHASE5:
000069 e204                          ldi temp, (1<<PB5)|(1<<PB2)
00006a b905                          out PORTB, temp
00006b ee88                          ldi r24, low(1000)
00006c e093                          ldi r25, high(1000)
00006d d03b                          rcall SMART_DELAY
00006e 2300                          tst temp
00006f f6c9                          brne MAIN_LOOP
000070 d058                          rcall CHECK_PEDESTRIAN
                                 
                                 PHASE6:
000071 e104                          ldi temp, (1<<PB4)|(1<<PB2)
000072 b905                          out PORTB, temp
000073 ee88                          ldi r24, low(1000)
000074 e093                          ldi r25, high(1000)
000075 d033                          rcall SMART_DELAY
000076 2300                          tst temp
000077 f689                          brne MAIN_LOOP
000078 cfd0                          rjmp MAIN_LOOP
                                 
                                 ; ============================================================
                                 ; NIGHT MODE
                                 ; ============================================================
                                 NIGHT_MODE:
000079 2766                          clr r22
00007a d047                          rcall GET_MILLIS
00007b 2fc8                          mov r28, r24
00007c 2fd9                          mov r29, r25
00007d 2777                          clr r23
00007e 27ee                          clr r30
00007f 27ff                          clr r31
                                 
                                 NIGHT_LOOP:
000080 d041                          rcall GET_MILLIS
000081 1b8c                          sub r24, r28
000082 0b9d                          sbc r25, r29
000083 3f84                          cpi r24, low(500)
000084 e001                          ldi temp, high(500)
000085 0790                          cpc r25, temp
000086 f060                          brlo NIGHT_CHECK_SWITCH
                                 
000087 e001                          ldi temp, 1
000088 2760                          eor r22, temp
000089 2366                          tst r22
00008a f019                          breq NIGHT_YELLOW_OFF
                                 
                                 NIGHT_YELLOW_ON:
00008b e102                          ldi temp, (1<<PB4)|(1<<PB1)
00008c b905                          out PORTB, temp
00008d c002                          rjmp UPDATE_FLASH_TIME
                                 
                                 NIGHT_YELLOW_OFF:
00008e e000                          ldi temp, 0
00008f b905                          out PORTB, temp
                                 
                                 UPDATE_FLASH_TIME:
000090 d031                          rcall GET_MILLIS
000091 2fc8                          mov r28, r24
000092 2fd9                          mov r29, r25
                                 
                                 NIGHT_CHECK_SWITCH:
000093 b106                          in temp, PINC
000094 fd02                          sbrc temp, PC2
000095 c002                          rjmp DAY_DETECTED
000096 2777                          clr r23
000097 cfe8                          rjmp NIGHT_LOOP
                                 
                                 DAY_DETECTED:
000098 2377                          tst r23
000099 f429                          brne HYSTERESIS_RUNNING
00009a e071                          ldi r23, 1
00009b d026                          rcall GET_MILLIS
00009c 2fe8                          mov r30, r24
00009d 2ff9                          mov r31, r25
00009e cfe1                          rjmp NIGHT_LOOP
                                 
                                 HYSTERESIS_RUNNING:
00009f d022                          rcall GET_MILLIS
0000a0 1b8e                          sub r24, r30
0000a1 0b9f                          sbc r25, r31
0000a2 3888                          cpi r24, low(5000)
0000a3 e103                          ldi temp, high(5000)
0000a4 0790                          cpc r25, temp
0000a5 f2d0                          brlo NIGHT_LOOP
0000a6 e000                          ldi temp, 0
0000a7 b905                          out PORTB, temp
0000a8 cfa0                          rjmp MAIN_LOOP
                                 
                                 ; ============================================================
                                 ; SMART DELAY (Fixed Stack Logic)
                                 ; ============================================================
                                 SMART_DELAY:
                                     ; Move requested delay straight to safe registers
0000a9 2f28                          mov r18, r24
0000aa 2f39                          mov r19, r25
0000ab d016                          rcall GET_MILLIS
0000ac 2fa8                          mov r26, r24
0000ad 2fb9                          mov r27, r25
                                 
                                 SMART_DELAY_LOOP:
0000ae d00c                          rcall IS_NIGHT
0000af 2300                          tst temp
0000b0 f441                          brne SMART_NIGHT
0000b1 d010                          rcall GET_MILLIS
0000b2 1b8a                          sub r24, r26
0000b3 0b9b                          sbc r25, r27
0000b4 1782                          cp r24, r18
0000b5 0793                          cpc r25, r19
0000b6 f3b8                          brlo SMART_DELAY_LOOP
0000b7 2700                          clr temp
0000b8 9508                          ret
                                 
                                 SMART_NIGHT:
0000b9 e001                          ldi temp, 1
0000ba 9508                          ret
                                 
                                 ; ============================================================
                                 ; UTILITIES & SUBROUTINES
                                 ; ============================================================
                                 IS_NIGHT:
0000bb b106                          in temp, PINC
0000bc fd02                          sbrc temp, PC2
0000bd c002                          rjmp NOT_NIGHT
0000be e001                          ldi temp, 1
0000bf 9508                          ret
                                 NOT_NIGHT:
0000c0 2700                          clr temp
0000c1 9508                          ret
                                 
                                 GET_MILLIS:
0000c2 94f8                          cli
0000c3 9180 0101                     lds r24, ms_low
0000c5 9190 0102                     lds r25, ms_mid
0000c7 9478                          sei
0000c8 9508                          ret
                                 
                                 CHECK_PEDESTRIAN:
0000c9 9100 0100                     lds temp, pedRequest
0000cb 2300                          tst temp
0000cc f089                          breq PED_DONE
0000cd dfed                          rcall IS_NIGHT
0000ce 2300                          tst temp
0000cf f471                          brne PED_DONE
                                 
0000d0 e204                          ldi temp, (1<<PB5)|(1<<PB2)
0000d1 b905                          out PORTB, temp
0000d2 e045                          ldi digit, 5
                                 
                                 PED_COUNTDOWN:
0000d3 2f84                          mov r24, digit
0000d4 d016                          rcall DISPLAY_DIGIT
0000d5 ee88                          ldi r24, low(1000)
0000d6 e093                          ldi r25, high(1000)
0000d7 d007                          rcall BASIC_DELAY
0000d8 954a                          dec digit
0000d9 f7ca                          brpl PED_COUNTDOWN
                                 
0000da d047                          rcall CLEAR_DISPLAY
0000db e000                          ldi temp, 0
0000dc 9300 0100                     sts pedRequest, temp
                                 PED_DONE:
0000de 9508                          ret
                                 
                                 BASIC_DELAY:
0000df 2f28                          mov r18, r24
0000e0 2f39                          mov r19, r25
0000e1 dfe0                          rcall GET_MILLIS
0000e2 2fa8                          mov r26, r24
0000e3 2fb9                          mov r27, r25
                                 BASIC_DELAY_LOOP:
0000e4 dfdd                          rcall GET_MILLIS
0000e5 1b8a                          sub r24, r26
0000e6 0b9b                          sbc r25, r27
0000e7 1782                          cp r24, r18
0000e8 0793                          cpc r25, r19
0000e9 f3d0                          brlo BASIC_DELAY_LOOP
0000ea 9508                          ret
                                 
                                 ; ============================================================
                                 ; 7-SEGMENT DISPLAY (Fixed Pull-Up Registers)
                                 ; ============================================================
                                 DISPLAY_DIGIT:
0000eb 3080                          cpi r24, 0
0000ec f059                          breq DISPLAY_0
0000ed 3081                          cpi r24, 1
0000ee f081                          breq DISPLAY_1
0000ef 3082                          cpi r24, 2
0000f0 f0a9                          breq DISPLAY_2
0000f1 3083                          cpi r24, 3
0000f2 f0d1                          breq DISPLAY_3
0000f3 3084                          cpi r24, 4
0000f4 f0f9                          breq DISPLAY_4
0000f5 3085                          cpi r24, 5
0000f6 f121                          breq DISPLAY_5
0000f7 9508                          ret
                                 
                                 DISPLAY_0:
0000f8 ef08                          ldi temp, 0b11111000
0000f9 6004                          ori temp, (1<<PD2)   ; Protect Pull-up
0000fa b90b                          out PORTD, temp
0000fb e001                          ldi temp, (1<<PC0)
0000fc 6004                          ori temp, (1<<PC2)   ; Protect Pull-up
0000fd b908                          out PORTC, temp
0000fe 9508                          ret
                                 
                                 DISPLAY_1:
0000ff e600                          ldi temp, (1<<PD6)|(1<<PD5)
000100 6004                          ori temp, (1<<PD2)
000101 b90b                          out PORTD, temp
000102 e000                          ldi temp, 0
000103 6004                          ori temp, (1<<PC2)
000104 b908                          out PORTC, temp
000105 9508                          ret
                                 
                                 DISPLAY_2:
000106 ed08                          ldi temp, (1<<PD7)|(1<<PD6)|(1<<PD4)|(1<<PD3)
000107 6004                          ori temp, (1<<PD2)
000108 b90b                          out PORTD, temp
000109 e002                          ldi temp, (1<<PC1)
00010a 6004                          ori temp, (1<<PC2)
00010b b908                          out PORTC, temp
00010c 9508                          ret
                                 
                                 DISPLAY_3:
00010d ef00                          ldi temp, (1<<PD7)|(1<<PD6)|(1<<PD5)|(1<<PD4)
00010e 6004                          ori temp, (1<<PD2)
00010f b90b                          out PORTD, temp
000110 e002                          ldi temp, (1<<PC1)
000111 6004                          ori temp, (1<<PC2)
000112 b908                          out PORTC, temp
000113 9508                          ret
                                 
                                 DISPLAY_4:
000114 e600                          ldi temp, (1<<PD6)|(1<<PD5)
000115 6004                          ori temp, (1<<PD2)
000116 b90b                          out PORTD, temp
000117 e003                          ldi temp, (1<<PC0)|(1<<PC1)
000118 6004                          ori temp, (1<<PC2)
000119 b908                          out PORTC, temp
00011a 9508                          ret
                                 
                                 DISPLAY_5:
00011b eb08                          ldi temp, (1<<PD7)|(1<<PD5)|(1<<PD4)|(1<<PD3)
00011c 6004                          ori temp, (1<<PD2)
00011d b90b                          out PORTD, temp
00011e e003                          ldi temp, (1<<PC0)|(1<<PC1)
00011f 6004                          ori temp, (1<<PC2)
000120 b908                          out PORTC, temp
000121 9508                          ret
                                 
                                 CLEAR_DISPLAY:
000122 b10b                          in temp, PORTD
000123 7007                          andi temp, 0b00000111
000124 b90b                          out PORTD, temp
000125 b108                          in temp, PORTC
000126 7f0c                          andi temp, 0b11111100
000127 6004                          ori temp, (1<<PC2)
000128 b908                          out PORTC, temp
000129 9508                          ret
                                 
                                 ; ============================================================
                                 ; INTERRUPT ROUTINES
                                 ; ============================================================
                                 INT0_ISR:
00012a 930f                          push temp
00012b b70f                          in temp, SREG
00012c 930f                          push temp
00012d e001                          ldi temp, 1
00012e 9300 0100                     sts pedRequest, temp
000130 910f                          pop temp
000131 bf0f                          out SREG, temp
000132 910f                          pop temp
000133 9518                          reti
                                 
                                 TIMER1_COMPA_ISR:
000134 930f                          push temp
000135 b70f                          in temp, SREG
000136 930f                          push temp
000137 9100 0101                     lds temp, ms_low
000139 9503                          inc temp
00013a 9300 0101                     sts ms_low, temp
00013c f489                          brne TIMER_DONE
00013d 9100 0102                     lds temp, ms_mid
00013f 9503                          inc temp
000140 9300 0102                     sts ms_mid, temp
000142 f459                          brne TIMER_DONE
000143 9100 0103                     lds temp, ms_high
000145 9503                          inc temp
000146 9300 0103                     sts ms_high, temp
000148 f429                          brne TIMER_DONE
000149 9100 0104                     lds temp, ms_top
00014b 9503                          inc temp
00014c 9300 0104                     sts ms_top, temp
                                 TIMER_DONE:
00014e 910f                          pop temp
00014f bf0f                          out SREG, temp
000150 910f                          pop temp


RESOURCE USE INFORMATION
------------------------

Notice:
The register and instruction counts are symbol table hit counts,
and hence implicitly used resources are not counted, eg, the
'lpm' instruction without operands implicitly uses r0 and z,
none of which are counted.

x,y,z are separate entities in the symbol table and are
counted separately from r26..r31 here.

.dseg memory usage only counts static data declared with .byte

